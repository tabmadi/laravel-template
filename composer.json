{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "example/laravel-app",
  "description": "A small Laravel app with a notes sample",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "~8.5.0",
    "ext-pdo_sqlite": "*",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.32.3",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^13.0.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "allow-plugins": {},
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}
